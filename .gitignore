# Build artifacts (the Unity template builds outside this tree, but guard anyway)
bin/
obj/
*.dll
*.pdb

# Editor/user state
*.user
*.csproj
*.sln

# Never commit player logs or captures (may contain account identifiers)
*.log
GameLogFull*.txt
captures/
logs/
Mod Build Logs*/
*.zip
*.7z

# Python bytecode from running the tools/
__pycache__/
*.pyc

# Never commit capture archives, vendored third-party source, or bundles.
*.bundle
FasterLoadingTimes-main/
research/
**/Mod Build Logs*/
**/GameLogFull*.txt
